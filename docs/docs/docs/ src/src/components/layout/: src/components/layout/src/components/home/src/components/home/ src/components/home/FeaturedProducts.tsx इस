
import React from "react";

export interface FeaturedProduct {
  id: string;
  name: string;
  category: string;
  image: string;
  imageAlt: string;
  price?: string;
  href?: string;
}

interface FeaturedProductsProps {
  heading?: string;
  subtitle?: string;
  products?: FeaturedProduct[];
  viewAllHref?: string;
  viewAllLabel?: string;
}

export default function FeaturedProducts({
  heading = "Featured Collection",
  subtitle = "Explore the selected pieces from our furniture collection.",
  products = [],
  viewAllHref,
  viewAllLabel = "View All",
}: FeaturedProductsProps) {
  return (
    <section
      aria-labelledby="featured-products-heading"
      className="w-full bg-white px-5 py-20 md:px-10 lg:px-16"
    >
      <div className="mx-auto max-w-7xl">
        <header className="mb-12 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
          <div>
            <span className="mb-4 block text-xs uppercase tracking-[0.3em] text-neutral-500">
              AurelIe Living
            </span>

            <h2
              id="featured-products-heading"
              className="font-serif text-3xl font-light tracking-wide text-neutral-900 md:text-5xl"
            >
              {heading}
            </h2>

            <p className="mt-4 max-w-xl text-sm leading-7 text-neutral-600 md:text-base">
              {subtitle}
            </p>
          </div>

          {viewAllHref && (
            <a
              href={viewAllHref}
              className="inline-flex w-fit items-center gap-3 border-b border-neutral-800 pb-2 text-xs uppercase tracking-[0.18em] text-neutral-900 transition-colors hover:text-neutral-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
            >
              {viewAllLabel}
              <span aria-hidden="true">→</span>
            </a>
          )}
        </header>

        {products.length > 0 ? (
          <div className="grid grid-cols-1 gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
            {products.map((product) => (
              <article key={product.id} className="group min-w-0">
                <a
                  href={product.href || "#"}
                  aria-label={`View ${product.name}`}
                  className="block overflow-hidden bg-[#f5f4f1] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
                >
                  <div className="aspect-[4/5] overflow-hidden">
                    <img
                      src={product.image}
                      alt={product.imageAlt}
                      loading="lazy"
                      decoding="async"
                      className="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    />
                  </div>
                </a>

                <div className="pt-5">
                  <p className="text-[10px] uppercase tracking-[0.2em] text-neutral-500">
                    {product.category}
                  </p>

                  <h3 className="mt-2 font-serif text-lg text-neutral-900">
                    {product.name}
                  </h3>

                  {product.price && (
                    <p className="mt-2 text-sm text-neutral-700">
                      {product.price}
                    </p>
                  )}
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div
            className="border-y border-neutral-200 py-12 text-center"
            role="status"
          >
            <p className="font-serif text-xl text-neutral-800">
              Product collection coming soon
            </p>
            <p className="mt-3 text-sm text-neutral-500">
              Product information will appear here once the catalogue is provided.
            </p>
          </div>
        )}
      </div>
    </section>
  );
}
